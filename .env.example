# Optional. Leave SMTP_HOST, SMTP_PORT, and SMTP_FROM empty to save
# warning emails in the in-app outbox instead of sending them.
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=ops@example.com
SMTP_USER=
SMTP_PASS=
# true, false, or empty. Empty uses true only for port 465.
SMTP_SECURE=

# Optional. Defaults to ./data/claim.db
DATABASE_PATH=

# SMTP2GO HTTP API. When SMTP2GO_API_KEY is set, warnings are sent through
# SMTP2GO (ahead of SMTP). Leave the key empty to use the outbox, or SMTP if
# SMTP_HOST, SMTP_PORT, and SMTP_FROM are all set.
SMTP2GO_API_KEY=
SMTP2GO_FROM=claim@bogdandelivery.com

# Optional SMTP fallback. Leave SMTP_HOST, SMTP_PORT, and SMTP_FROM empty to
# save warning emails in the in-app outbox instead of sending them.
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=ops@example.com
SMTP_USER=
SMTP_PASS=
# true, false, or empty. Empty uses true only for port 465.
SMTP_SECURE=

# Optional. Defaults to ./data/claim.db
DATABASE_PATH=
